[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
[diff]
	external = difft
[alias]
  s = status -s
  lg = log --pretty=format:\"%C(magenta)%h%Creset -%C(red)%d%Creset %s %C(dim green)(%cr) [%an]\" --abbrev-commit -30
  br = branch --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(contents:subject) %(color:green)(%(committerdate:relative)) [%(authorname)]' --sort=-committerdate
  fu = fetch upstream
  mum = merge upstream/master
  pom = push origin master
  cob = checkout -b
  cm = checkout master
  del = branch -D
  sh = show --ext-diff
  a = !git config --get-regexp ^alias\\. | sed -e s/^alias\\.// -e s/\\ /\\ =\\ /
[gpg]
	format = x509
[include]
  path = ~/.config/git/gitconfig.local
[gpg "x509"]
	program = /opt/uber/bin/signingfx
