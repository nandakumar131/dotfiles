
alias reload!='. ~/.zshrc'
alias ji="${HOME}/.dotfiles/bin/jira"
alias pd="${HOME}/.dotfiles/bin/pagerduty"
alias gl="${HOME}/.dotfiles/bin/git-log"
alias dotup="(cd ${HOME}/.dotfiles && git pull && ./install.sh)"

command -v nvim >/dev/null 2>&1 && alias vi='nvim'
command -v sesh >/dev/null 2>&1 && alias sec='sesh connect "$(sesh list -t | fzf --margin=0,40 --height 20% --ansi --prompt ⚡)"'

if command -v lsd >/dev/null 2>&1; then
  alias ls='lsd'
  alias ll='lsd -lh'
  alias la='lsd -a'
  alias tree='lsd --tree'
fi

if command -v walk >/dev/null 2>&1; then
  alias lk='walk --icons'
fi

if command -v mdcat >/dev/null 2>&1; then
  alias mdcat='mdcat --theme solarized-dark'
fi

# Debian/Ubuntu ship these under different binary names (bat -> batcat,
# fd -> fd-find's fdfind) to avoid clashes with unrelated packages.
command -v bat >/dev/null 2>&1 || { command -v batcat >/dev/null 2>&1 && alias bat=batcat; }
command -v fd >/dev/null 2>&1 || { command -v fdfind >/dev/null 2>&1 && alias fd=fdfind; }

alias g='git'
alias gbc='git rev-parse --abbrev-ref HEAD | tr -d "\n" | c'

alias cgrep='grep --color'

# Print each PATH entry on a separate line
alias path='echo -e ${PATH//:/\\n}'

if command -v pbcopy >/dev/null 2>&1; then
  alias c='pbcopy'
elif command -v xclip >/dev/null 2>&1; then
  alias c='xclip -selection clipboard'
elif command -v xsel >/dev/null 2>&1; then
  alias c='xsel --clipboard --input'
fi

# tmux
alias xls='tmux ls'
alias xa='tmux attach -t'
alias xd='tmux detach'


# kitten
command -v kitten >/dev/null 2>&1 && alias goto='kitten ssh'
