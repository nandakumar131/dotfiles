
autoload -U colors && colors
PROMPT="%{$fg[blue]%} ❯ %{$reset_color%}"

# Dynamically locate and load Homebrew
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv zsh)"
fi

fpath=( ${HOME}/.dotfiles/autocomplete "${fpath[@]}" )
export PATH="${HOME}/.dotfiles/bin:${PATH}"

[ -f ~/.dotfiles/config/zsh/alias ] && source ~/.dotfiles/config/zsh/alias
[ -f ~/.dotfiles/config/zsh/functions ] && source ~/.dotfiles/config/zsh/functions

# machine-local overrides/extras
[ -f ~/.config/zsh/zshrc.local ] && source ~/.config/zsh/zshrc.local
[ -f ~/.config/zsh/alias.local ] && source ~/.config/zsh/alias.local
[ -f ~/.config/zsh/functions.local ] && source ~/.config/zsh/functions.local

# Homebrew prefix if present (macOS or Linuxbrew); empty otherwise so the
# path lookups below just fall through to the plain Linux package paths.
BREW_PREFIX=""
command -v brew >/dev/null 2>&1 && BREW_PREFIX="$(brew --prefix)"

# source the first of these that exists, so config only kicks in for
# tools/packages that are actually installed on this machine
_source_first() {
	local f
	for f in "$@"; do
		[ -f "$f" ] && source "$f" && return
	done
}

command -v fzf >/dev/null 2>&1 && source <(fzf --zsh)
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh)"
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"

autoload -U compinit
compinit -i

# fzf-tab must load after compinit, but before plugins that wrap zle
# widgets (zsh-autosuggestions, zsh-syntax-highlighting)
_source_first \
	"${BREW_PREFIX}/share/fzf-tab/fzf-tab.zsh" \
	"/usr/share/fzf-tab/fzf-tab.zsh"

_source_first \
	"${BREW_PREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
	"/usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

_source_first \
	"${BREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
	"/usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"


command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init -)"

if [ -s "${HOME}/.nvm/nvm.sh" ]; then
	export NVM_DIR="${HOME}/.nvm"
	source "${NVM_DIR}/nvm.sh"
	[ -s "${NVM_DIR}/bash_completion" ] && source "${NVM_DIR}/bash_completion"
fi

for _pnpm_home in "${HOME}/Library/pnpm" "${HOME}/.local/share/pnpm"; do
	if [ -d "$_pnpm_home" ]; then
		export PNPM_HOME="$_pnpm_home"
		case ":$PATH:" in
		*":$PNPM_HOME:"*) ;;
		*) export PATH="$PNPM_HOME:$PATH" ;;
		esac
		break
	fi
done
unset _pnpm_home

setopt autocd

if command -v nvim >/dev/null 2>&1; then
	export EDITOR='nvim'
	export WALK_EDITOR='nvim'
else
	export EDITOR='vi'
fi

export FZF_DEFAULT_OPTS='--height 70% --reverse --inline-info --cycle --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc --color=marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8 --color=selected-bg:#45475a --color=border:#313244,label:#cdd6f4'

if command -v fd >/dev/null 2>&1; then
	export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
	export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
	export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
fi

# gum theming - match the catppuccin mocha accents used in tmux
export GUM_CHOOSE_CURSOR_FOREGROUND="212"
export GUM_CONFIRM_SELECTED_BACKGROUND="212"
export GUM_INPUT_CURSOR_FOREGROUND="212"
export GUM_SPIN_SPINNER_FOREGROUND="212"

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#737272"

# history setup
HISTFILE=${HOME}/.zsh_history
SAVEHIST=1000
HISTSIZE=2000

setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify

# keybindings
bindkey -e
bindkey '^ ' forward-word
#bindkey "^i" vi-cmd-mode

bindkey "^[[A" history-search-backward
bindkey "^[[B" history-search-forward

# keybinding for tmux
bindkey "^u" backward-kill-line

launcher-widget() {
	local cmd
  zle -I
	cmd=$(launcher </dev/tty)
	if [ -n "$cmd" ]; then
    eval "$cmd"
	fi
  zle redisplay
}
zle -N launcher-widget
bindkey "^g" launcher-widget

bindkey -s "^t" "sec\n"

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"
